BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NOVA_DATABASE_PATH=./data/nova.sqlite

# Default: run a downloaded model on the same machine as Nova, without API keys.
NOVA_AI_PROVIDER=ollama
# Starting candidate for 16GB RAM + RTX 5070; benchmark before activation.
NOVA_OLLAMA_MODEL=qwen2.5-coder:7b
# Enable only after a real npm run ai:smoke succeeds.
NOVA_AI_ENABLED=0
# Legacy optional provider, used ONLY when NOVA_AI_PROVIDER=openrouter:
# NOVA_AI_API_KEY=
# NOVA_AI_MODEL=thinkingmachines/inkling:free
