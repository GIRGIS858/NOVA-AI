BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NOVA_DATABASE_PATH=./data/nova.sqlite

# Add the OpenRouter API credential securely in environment settings or your private .env.local.
NOVA_AI_API_KEY=
# Enable only after npm run ai:smoke passes; only zero-priced :free models are permitted.
NOVA_AI_ENABLED=0
NOVA_AI_MODEL=thinkingmachines/inkling:free
